{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "melhorias.schema.json",
  "title": "Melhorias da empresa",
  "type": "array",
  "minItems": 1,
  "maxItems": 12,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nome", "descricao", "custo", "manutencao", "efeito", "licao"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
      "nome": { "type": "string", "minLength": 3, "maxLength": 32 },
      "descricao": { "type": "string", "minLength": 10, "maxLength": 80 },
      "custo": { "type": "integer", "minimum": 0, "maximum": 100000 },
      "manutencao": { "type": "integer", "minimum": 0, "maximum": 10000 },
      "licao": { "type": "string", "minLength": 10, "maxLength": 140 },
      "efeito": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo"],
            "properties": { "tipo": { "enum": ["vida", "combo", "enfeite"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "segundos"],
            "properties": { "tipo": { "const": "tempo" }, "segundos": { "type": "integer", "minimum": 1, "maximum": 20 } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "percentual"],
            "properties": { "tipo": { "const": "renda" }, "percentual": { "type": "integer", "minimum": 1, "maximum": 100 } }
          }
        ]
      }
    }
  }
}
