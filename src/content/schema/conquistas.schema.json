{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "conquistas.schema.json",
  "title": "Conquistas",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "titulo", "descricao", "condicao"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
      "titulo": { "type": "string", "minLength": 3, "maxLength": 30 },
      "descricao": { "type": "string", "minLength": 10, "maxLength": 100 },
      "condicao": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "faseId"],
            "properties": { "tipo": { "const": "faseConcluida" }, "faseId": { "type": "string" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "passoTipo", "minimo"],
            "properties": {
              "tipo": { "const": "notaMinima" },
              "passoTipo": { "enum": ["decisao", "orcamento"] },
              "minimo": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "atributo", "valor"],
            "properties": {
              "tipo": { "const": "atributoMinimo" },
              "atributo": {
                "enum": ["dinheiro", "energia", "conhecimento", "tecnica", "reputacao", "saudeFinanceira", "seguranca", "networking"]
              },
              "valor": { "type": "integer" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "quantidade"],
            "properties": { "tipo": { "const": "sequenciaPerfeita" }, "quantidade": { "type": "integer", "minimum": 2, "maximum": 20 } }
          }
        ]
      }
    }
  }
}
