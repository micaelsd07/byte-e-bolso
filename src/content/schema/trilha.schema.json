{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trilha.schema.json",
  "title": "Trilha",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nome",
    "sigla",
    "resumo",
    "unidades"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 24
    },
    "nome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "sigla": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4
    },
    "resumo": {
      "type": "string",
      "minLength": 10,
      "maxLength": 140
    },
    "unidades": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "capitulo.schema.json"
      }
    }
  }
}
