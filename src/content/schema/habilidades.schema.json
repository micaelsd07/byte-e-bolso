{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "habilidades.schema.json",
  "title": "Habilidades",
  "type": "array",
  "minItems": 1,
  "maxItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nome", "descricao", "cooldown", "efeito"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
      "nome": { "type": "string", "minLength": 3, "maxLength": 24 },
      "descricao": { "type": "string", "minLength": 10, "maxLength": 80 },
      "cooldown": { "type": "integer", "minimum": 1, "maximum": 12 },
      "efeito": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo"],
            "properties": { "tipo": { "enum": ["dica", "eliminarPior"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "valor"],
            "properties": { "tipo": { "const": "energia" }, "valor": { "type": "integer", "minimum": 1, "maximum": 50 } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "percentual"],
            "properties": {
              "tipo": { "const": "bonusDesafio" },
              "percentual": { "type": "integer", "minimum": 1, "maximum": 50 }
            }
          }
        ]
      }
    }
  }
}
