{
  "name": "byte-e-bolso",
  "version": "0.1.0",
  "private": true,
  "description": "Jogo educativo mobile-first de tecnologia, finanças e carreira para o Framework Arcade.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . && tsc --noEmit",
    "content:check": "node scripts/validar-conteudo.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit-unit.xml",
    "build": "npm run content:check && vite build && node scripts/versao.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "e2e": "playwright test",
    "gdd:pdf": "node scripts/gdd-pdf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^2.1.8",
    "ajv": "^8.17.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "marked": "^15.0.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
